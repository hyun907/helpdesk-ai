---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const docs = await getCollection('policies');

/** 원문 첫 h1 을 제목으로 쓴다. 원본에 frontmatter 를 추가하지 않기 위해서다. */
function titleOf(body: string, fallback: string): string {
  return body.match(/^#\s+(.+?)\s*$/m)?.[1] ?? fallback;
}

/** 조항(h2) 이름들. 번호는 떼고 이름만 남긴다. */
function clausesOf(body: string): string[] {
  return [...body.matchAll(/^##\s+(.+?)\s*$/gm)].map((m) => m[1].replace(/^\d+\.\s*/, ''));
}

/**
 * 첫 조항 구간만 잘라낸다.
 * 문서 전체에서 첫 산문을 찾으면, 앞 조항이 표로만 되어 있을 때
 * 한참 뒤 조항의 문장이 딸려 와 요약이 엉뚱해진다(제재 규정이 그렇다).
 */
function firstSection(body: string): string {
  const from = body.search(/^##\s+/m);
  if (from < 0) return body;
  const after = body.slice(from).replace(/^.*\n/, '');
  const next = after.search(/^##\s+/m);
  return next < 0 ? after : after.slice(0, next);
}

/** 첫 조항의 첫 문장. 표로만 이뤄진 조항이면 요약을 만들지 않는다. */
function excerptOf(body: string): string | null {
  const line = firstSection(body)
    .split('\n')
    .map((l) => l.trim())
    .find((l) => l && !l.startsWith('#') && !l.startsWith('|') && !l.startsWith('---'));
  if (!line) return null;
  return line
    .replace(/^[-*]\s+/, '')
    .replace(/^\d+\.\s+/, '')
    .replace(/\*\*(.+?)\*\*/g, '$1')
    .trim();
}

const items = docs
  .map((entry) => {
    const body = entry.body ?? '';
    const clauses = clausesOf(body);
    return {
      slug: entry.id,
      file: `${entry.id}.md`,
      title: titleOf(body, entry.id),
      // 요약이 없는 문서(표 위주)는 조항 이름을 대신 보여준다 — 목록에서 더 유용하다.
      excerpt: excerptOf(body) ?? clauses.join(' · '),
      clauses: clauses.length,
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title, 'ko'));
---

<BaseLayout
  title="운영 정책"
  description="HelpDesk AI 가 답변 근거로 인용하는 운영 정책 원문."
>
  <h1>운영 정책</h1>
  <p class="lede">
    AI 답변에 붙는 <strong>출처</strong>는 이 문서들을 가리킵니다.
    인용된 조항을 눌러 원문에서 직접 확인할 수 있습니다.
  </p>

  <ul class="doc-list">
    {items.map((doc) => (
      <li>
        <a href={`/docs/${doc.slug}`}>
          <span class="doc-title">{doc.title}</span>
          <span class="doc-excerpt">{doc.excerpt}</span>
          <span class="doc-meta">
            <code>{doc.file}</code>
            <span class="dot">·</span>
            {doc.clauses}개 조항
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style is:global>
  /* h1 · .lede 는 pixel.css 에서 전역으로 잡는다 — 여기서 다시 정의하지 않는다 */
  .doc-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.8rem; }

  /* 문서 한 건 = 책장에 꽂힌 두루마리 한 장 */
  .doc-list a {
    --px-bg: var(--cream-2);
    --px-bd: var(--wood-2);
    display: grid; gap: 0.35rem;
    padding: 1.15rem 1.3rem;
    text-decoration: none; color: var(--ink);
    transition: transform 60ms steps(1);
  }
  .doc-list a:hover { --px-bg: var(--hover-fill); --px-bd: var(--wood); }
  /* 누르면 도트 한 칸 내려간다 — 버튼과 같은 감각 */
  .doc-list a:active { transform: translateY(var(--u)); }

  .doc-title {
    font-family: 'Galmuri11', 'Apple SD Gothic Neo', sans-serif;
    font-size: 24px; line-height: 32px; letter-spacing: 0; font-weight: 700;
    color: var(--ink);
  }
  .doc-title::before { content: '▤ '; color: var(--wood); }

  /* 요약은 두 줄 읽는 글이다 — 픽셀 폰트를 쓰지 않는다 */
  .doc-excerpt {
    color: var(--ink-soft); font-size: 0.92rem; line-height: 1.7;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .doc-meta {
    font-family: 'Galmuri11', 'Apple SD Gothic Neo', sans-serif;
    font-size: 12px; line-height: 20px; letter-spacing: 0;
    color: var(--ink-soft); margin-top: 0.3rem;
  }
  .doc-meta code { font-size: 11px; }
  .doc-meta .dot { margin: 0 0.4rem; color: var(--rose); }

  @media (prefers-reduced-motion: reduce) {
    .doc-list a { transition: none; }
    .doc-list a:active { transform: none; }
  }
</style>
