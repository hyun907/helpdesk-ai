---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('policies');

  /**
   * 문서가 하나도 안 잡히면 빌드를 멈춘다.
   *
   * 이 컬렉션은 백엔드 리소스(../src/main/resources/docs)를 직접 가리킨다.
   * 그쪽에서 문서를 옮기거나 이름을 바꾸면 여기서는 빈 컬렉션이 되는데,
   * Astro 는 경고만 찍고 빌드를 성공시킨다 — 종료코드 0, 산출물도 나온다.
   * 그러면 정책 페이지만 소리 없이 사라진 채 배포되고, 답변에 붙는 출처 링크가
   * 전부 404 가 된다. 근거를 확인하라고 만든 링크가 근거를 못 찾는 상태다.
   *
   * 조용히 틀리느니 시끄럽게 멈추는 편이 낫다.
   */
  if (docs.length === 0) {
    throw new Error(
      '정책 문서를 하나도 찾지 못했습니다. ' +
        'src/content.config.ts 의 glob base 가 가리키는 경로에 .md 파일이 있는지 확인하세요 ' +
        '— 백엔드에서 문서를 옮겼거나 이름을 바꿨을 수 있습니다.',
    );
  }

  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// 문서 제목은 본문 첫 h1 에서 가져온다. 원문에 frontmatter 를 넣지 않기 위해서다 —
// 이 파일들은 백엔드가 인제스트하는 원본이므로 프런트 사정으로 고치지 않는다.
const title = headings.find((h) => h.depth === 1)?.text ?? entry.id;

// 목차는 조항(h2)까지만. 이 문서들은 "1. 복구 신청 기한" 같은 조항 단위로 인용된다.
const toc = headings.filter((h) => h.depth === 2);

// RAG 답변이 출처로 표기하는 값과 정확히 같은 문자열이다.
const sourceFile = `${entry.id}.md`;
---

<BaseLayout title={title}>
  <article>
    <p class="eyebrow">
      운영 정책 · <code>{sourceFile}</code>
    </p>

    {/* 제목은 원문 h1 을 그대로 쓰되, 목차보다 위에 오도록 여기서 직접 렌더한다.
        원문 쪽 h1 은 .prose h1 규칙으로 감춘다 — 원본 마크다운은 건드리지 않는다. */}
    <h1 class="doc-title">{title}</h1>

    {toc.length > 0 && (
      <nav class="toc" aria-label="목차">
        <p class="toc-title">조항</p>
        {/* ul 을 쓴다. 조항 번호는 원문 제목에 이미 들어 있어서
            ol 의 자동 번호와 겹치면 "1. 1. 제재 종류" 가 된다. */}
        <ul>
          {toc.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="prose"><Content /></div>
  </article>

  <a class="back" href="/docs">← 정책 목록</a>
</BaseLayout>

<style is:global>
  .eyebrow {
    margin: 0 0 0.6rem;
    font-family: var(--font-pixel);
    font-size: 15px; line-height: 22px; letter-spacing: 0;
    color: var(--ink-soft);
  }
  .eyebrow::before { content: '▤ '; color: var(--wood); }

  /* 문서 제목 — 아래를 나무 울타리 한 줄로 받친다 */
  .doc-title {
    font-family: var(--font-display);
    font-size: 36px; line-height: 48px; letter-spacing: 0; font-weight: 700;
    color: var(--ink);
    margin: 0 0 1.5rem; padding-bottom: 0.9rem;
    /* 도트 울타리 — hr 과 같은 무늬로 맞춘다 */
    border-bottom: var(--u) solid transparent;
    border-image: repeating-linear-gradient(
      90deg,
      var(--wood-2) 0 var(--u),
      transparent var(--u) calc(var(--u) * 2)
    ) 1;
  }

  /* 조항 목차 = 미션 판 */
  .toc {
    --px-bg: var(--cream-2);
    --px-bd: var(--wood-2);
    margin: 1.75rem 0 2.5rem;
    padding: 1.1rem 1.3rem;
  }
  .toc-title {
    margin: 0 0 0.6rem;
    font-family: var(--font-pixel);
    font-size: 15px; line-height: 22px; letter-spacing: 0; font-weight: 400;
    color: var(--on-fill);
    display: inline-block;
    padding: 3px 10px;
    background: var(--sun);
    box-shadow: 0 0 0 2px var(--wood-2);
  }
  .toc ul { margin: 0; padding: 0; list-style: none; }
  .toc li { font-size: 0.93rem; margin: 0.2rem 0; padding-left: 1.1rem; position: relative; }
  /* 도트 하나짜리 불릿 */
  .toc li::before {
    content: '';
    position: absolute; left: 0; top: 0.72em;
    width: var(--u); height: var(--u);
    background: var(--rose);
  }
  .toc a { color: var(--ink); text-decoration: none; }
  .toc a:hover { color: var(--rose-deep); text-decoration: underline; }

  .back {
    --px-bg: var(--cream-2);
    --px-bd: var(--wood-2);
    --px-u: 3px;
    display: inline-block; margin-top: 2.5rem;
    padding: 7px 15px;
    font-family: var(--font-pixel);
    font-size: 15px; line-height: 22px; letter-spacing: 0; font-weight: 400;
    color: var(--ink); text-decoration: none;
    /* .px 목록에 없는 요소라 판을 직접 두르지 않고 각진 테두리로 처리한다 */
    border: 3px solid var(--wood-2);
  }
  .back:hover { background: var(--hover-fill); border-color: var(--wood); }

  /* ── 정책 원문 렌더 ───────────────────────────────
     여기부터는 '읽는 글'이다. 픽셀 폰트를 쓰지 않는다.
     조항 제목(h2)만 도트로 잡아 구간을 나눈다. */
  /* 원문 h1 은 위에서 .doc-title 로 이미 렌더했다. 접근성 트리에서도 빠지도록 display:none. */
  .prose h1 { display: none; }
  .prose h2 {
    font-family: var(--font-display);
    font-size: 24px; line-height: 32px; letter-spacing: 0; font-weight: 700;
    margin: 2.75rem 0 1rem;
    scroll-margin-top: 6rem;
    color: var(--ink);
  }
  .prose h2::before { content: '▸ '; color: var(--rose); }
  /* h3 는 픽셀 폰트를 쓰지 않는다. 12px 로 내리면 본문(16px)보다 작아져
     위계가 거꾸로 뒤집히고, 18px 로 올리면 도트 격자가 어긋나 흐려진다. */
  .prose h3 {
    font-size: 1.05rem; font-weight: 700; margin: 2rem 0 0.6rem;
    scroll-margin-top: 6rem;
    padding-left: 0.9rem; position: relative;
  }
  .prose h3::before {
    content: '';
    position: absolute; left: 0; top: 0.62em;
    width: var(--u); height: var(--u);
    background: var(--mint);
    box-shadow: 0 0 0 2px var(--wood-2);
  }

  /* 출처 링크로 특정 조항에 진입하면 그 조항을 눈에 띄게 표시한다.
     "3회 위반 시 이용 정지 7일" 이라는 답변의 근거가 화면 어디인지 바로 보이게 한다.
     border-radius 는 주지 않는다 — 각진 형광펜이 도트에 맞는다. */
  .prose h2:target,
  .prose h3:target {
    background: var(--mark);
    box-shadow: -0.6rem 0 0 var(--mark), 0.6rem 0 0 var(--mark);
  }

  .prose p { margin: 0.95rem 0; }
  .prose ul, .prose ol { padding-left: 1.35rem; }
  .prose li { margin: 0.35rem 0; }
  .prose ul { list-style: none; padding-left: 1.1rem; }
  .prose ul > li { position: relative; padding-left: 0.9rem; }
  .prose ul > li::before {
    content: '';
    position: absolute; left: 0; top: 0.72em;
    width: var(--u); height: var(--u);
    background: var(--wood-2);
  }
  .prose strong { font-weight: 700; color: var(--ink); }

  /* 표가 이 문서들의 핵심이다 — 제재 수위, 복구 가능 사유가 전부 표로 되어 있다.
     좁은 화면에서 표만 가로 스크롤되게 하고 페이지 본문은 절대 흔들지 않는다. */
  .prose table {
    display: block; overflow-x: auto;
    width: 100%; max-width: 100%;
    border-collapse: collapse;
    margin: 1.35rem 0;
    font-size: 0.93rem;
  }
  /* nowrap 을 두지 않는다. 이 표들은 '비고' 칸에 문장이 들어가서,
     한 줄로 강제하면 좁은 화면에서 내용이 스크롤 밖으로 완전히 사라진다.
     줄바꿈시키고, overflow-x 는 그래도 넘칠 때의 안전망으로만 남긴다. */
  .prose td { min-width: 6em; }
  .prose thead th {
    background: var(--cream-3);
    font-family: var(--font-pixel);
    font-size: 15px; line-height: 22px; letter-spacing: 0; font-weight: 400;
    color: var(--ink);
    text-align: left;
  }
  .prose th, .prose td {
    border: 3px solid var(--wood-2);
    padding: 0.6rem 0.9rem;
  }
  .prose tbody tr:nth-child(even) { background: var(--cream-2); }

  .prose blockquote {
    --px-bg: var(--cream-2);
    --px-bd: var(--mint);
    margin: 1.35rem 0; padding: 0.85rem 1.15rem;
    color: var(--ink);
  }
  /* 울타리 한 줄 — 도트를 반복해 구분선을 만든다 */
  .prose hr {
    border: 0; height: var(--u); margin: 2.5rem 0;
    background: repeating-linear-gradient(
      90deg,
      var(--wood-2) 0 var(--u),
      transparent var(--u) calc(var(--u) * 2)
    );
  }
</style>
