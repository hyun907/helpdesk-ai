---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chat from '../components/Chat.jsx';
---

<BaseLayout
  title="상담"
  description="게임 고객지원 어시스턴트 — 운영 정책과 계정 데이터를 함께 다룹니다."
>
  <h1>상담</h1>
  <p class="lede">
    운영 정책과 캐릭터·제재 데이터를 한 대화 안에서 다룹니다.
    규정을 인용한 답변에는 <strong>근거 문서</strong>가 함께 붙습니다.
  </p>

  <Chat client:load />
</BaseLayout>

<style>
  h1 { font-size: 1.9rem; letter-spacing: -0.02em; margin: 0 0 0.5rem; }
  .lede { color: var(--fg-muted); margin: 0 0 1.75rem; }
  .lede strong { color: var(--fg); }
</style>

<style is:global>
  .chat { display: flex; flex-direction: column; gap: 0.75rem; }

  .chat-head {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    font-size: 0.8rem; color: var(--fg-muted);
  }
  .chat-head code { font-size: 0.78rem; }

  /* ── 대화 로그 ───────────────────────────────────── */
  .chat .log {
    display: flex; flex-direction: column; gap: 1.1rem;
    min-height: 22rem; max-height: 60vh; overflow-y: auto;
    padding: 1.25rem;
    background: var(--bg-soft);
    border: 1px solid var(--border); border-radius: var(--radius);
  }

  .chat .empty { color: var(--fg-muted); font-size: 0.92rem; margin: auto 0; }
  .chat .empty p { margin: 0 0 0.6rem; }
  .chat .empty ul { margin: 0; padding-left: 1.2rem; }
  .chat .empty li { margin: 0.25rem 0; }

  .chat .msg { display: flex; flex-direction: column; gap: 0.45rem; max-width: 100%; }
  .chat .msg.user { align-items: flex-end; }
  .chat .msg.assistant { align-items: flex-start; }

  .chat .bubble {
    max-width: 46em;
    padding: 0.7rem 1rem;
    border-radius: var(--radius);
    line-height: 1.7;
    white-space: pre-wrap;          /* 답변의 줄바꿈·목록을 그대로 살린다 */
    overflow-wrap: break-word;
  }
  .chat .msg.user .bubble { background: var(--accent); color: #fff; }
  .chat .msg.assistant .bubble { background: var(--bg); border: 1px solid var(--border); }

  /* 스트리밍 중임을 알리는 커서. 토큰이 멈춘 건지 끝난 건지 구분된다. */
  .chat .caret {
    display: inline-block; width: 0.5em; height: 1.05em;
    margin-left: 2px; vertical-align: text-bottom;
    background: var(--accent);
    animation: chat-blink 1s step-end infinite;
  }
  @keyframes chat-blink { 50% { opacity: 0; } }

  .chat .msg-error { margin: 0.5rem 0 0; font-size: 0.88rem; color: #c0392b; }

  /* ── 근거 ────────────────────────────────────────── */
  .chat .sources {
    display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;
    font-size: 0.8rem;
  }
  .chat .sources-label {
    color: var(--fg-muted); font-weight: 600;
    letter-spacing: 0.04em;
  }
  .chat .chip {
    padding: 0.2rem 0.6rem;
    background: var(--accent-soft); color: var(--fg);
    border: 1px solid transparent; border-radius: 999px;
    text-decoration: none;
  }
  .chat .chip:hover { border-color: var(--accent); }
  .chat .sources.none { color: var(--fg-muted); font-size: 0.78rem; }

  /* ── 입력 ────────────────────────────────────────── */
  .chat .composer { display: flex; gap: 0.6rem; align-items: stretch; }
  .chat .composer textarea {
    flex: 1 1 auto; min-width: 0; resize: vertical;
    padding: 0.7rem 0.9rem;
    font: inherit; font-size: 0.95rem; line-height: 1.6;
    color: var(--fg); background: var(--bg);
    border: 1px solid var(--border); border-radius: var(--radius);
  }
  .chat .composer textarea:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent;
  }
  .chat .composer button {
    flex: 0 0 auto; align-self: stretch;
    padding: 0 1.3rem;
    font: inherit; font-size: 0.92rem; font-weight: 600;
    color: #fff; background: var(--accent);
    border: 1px solid transparent; border-radius: var(--radius);
    cursor: pointer;
  }
  .chat button.ghost {
    padding: 0.3rem 0.7rem; font: inherit; font-size: 0.8rem;
    color: var(--fg-muted); background: transparent;
    border: 1px solid var(--border); border-radius: var(--radius);
    cursor: pointer;
  }
  .chat button:hover:not(:disabled) { filter: brightness(1.08); }
  .chat button.ghost:hover:not(:disabled) { color: var(--fg); border-color: var(--fg-muted); filter: none; }
  .chat button:disabled { opacity: 0.5; cursor: not-allowed; }
</style>
