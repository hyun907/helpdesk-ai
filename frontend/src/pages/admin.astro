---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChunkInspector from '../components/ChunkInspector.jsx';
---

<BaseLayout
  title="검색 점검"
  description="벡터 스토어에서 실제로 무엇이 검색되는지 점수와 함께 확인합니다."
>
  <h1>검색 점검</h1>
  <p class="lede">
    답변을 만들기 전에 <strong>무엇이 검색되는지</strong> 먼저 봅니다.
    검색이 잘못됐는데 프롬프트를 고치는 일을 막기 위한 창구입니다.
  </p>

  {/* client:load — 이 페이지에서 유일하게 자바스크립트가 실리는 지점이다.
      나머지(헤더·문서 페이지)는 전부 정적 HTML 로 나간다. */}
  <ChunkInspector client:load />
</BaseLayout>

<style is:global>
  /* ── 검색 컨트롤 ───────────────────────────────────
     입력칸은 모서리를 깎지 않는다 — clip-path 가 포커스 링을 잘라 먹는다.
     각진 3px 테두리만으로도 충분히 도트답다. */
  .inspector .controls {
    display: flex; gap: 0.6rem; align-items: stretch; flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }
  .inspector input[type='search'] {
    flex: 1 1 18rem; min-width: 0;
    padding: 0.6rem 0.85rem;
    font: inherit; font-size: 0.95rem;
    color: var(--ink); background: var(--cream-2);
    border: 3px solid var(--wood-2); border-radius: 0;
    -webkit-appearance: none; appearance: none;
  }
  .inspector input::placeholder { color: var(--ink-soft); opacity: 1; }
  .inspector input:focus-visible {
    outline: 3px solid var(--rose-deep); outline-offset: 2px;
    border-color: var(--wood);
  }
  .inspector .topk {
    display: flex; align-items: center; gap: 0.45rem;
    padding: 0 0.7rem;
    font-family: var(--font-pixel);
    font-size: 15px; letter-spacing: 0;
    color: var(--ink-soft); background: var(--cream-2);
    border: 3px solid var(--wood-2); border-radius: 0;
  }
  .inspector .topk input {
    width: 3.4rem; padding: 0.35rem 0.4rem;
    font: inherit; font-size: 15px;
    color: var(--ink); background: transparent;
    border: 0; border-left: 3px solid var(--wood-2); border-radius: 0;
  }

  .inspector button {
    --px-bg: var(--rose);
    --px-bd: var(--wood);
    padding: 0.6rem 1.1rem;
    font-family: var(--font-pixel);
    font-size: 15px; letter-spacing: 0; font-weight: 400;
    color: var(--on-fill);
  }
  .inspector button:hover:not(:disabled) { --px-bg: var(--rose-2); }
  .inspector button.ghost {
    --px-bg: var(--cream-2);
    --px-bd: var(--wood-2);
    --px-u: 3px;
    color: var(--ink); font-weight: 400;
    padding: 6px 13px; font-size: 15px;
  }
  .inspector button.ghost:hover:not(:disabled) { --px-bg: var(--hover-fill); --px-bd: var(--wood); }
  /* 되돌릴 수 없는 재색인 — 색으로 먼저 경고한다 */
  .inspector button.danger {
    --px-bg: var(--danger-fill);
    --px-bd: var(--danger);
    color: var(--on-fill);
    padding: 6px 13px; font-size: 15px;
  }
  .inspector button.danger:hover:not(:disabled) { --px-bg: var(--danger-fill-2); }

  /* 재색인 줄 — 아래를 나무 울타리 한 줄로 막는다 */
  .inspector .ingest-row {
    display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
    padding-bottom: 1.5rem; margin-bottom: 1.5rem;
    border-bottom: var(--u) solid transparent;
    border-image: repeating-linear-gradient(
      90deg,
      var(--wood-2) 0 var(--u),
      transparent var(--u) calc(var(--u) * 2)
    ) 1;
  }
  .inspector .hint {
    font-family: var(--font-pixel);
    font-size: 15px; line-height: 22px; letter-spacing: 0;
    color: var(--ink-soft);
  }
  .inspector .hint.ok { color: var(--ink); }
  .inspector .hint.ok::before { content: '▪ '; color: var(--mint); }
  .inspector .hint.bad { color: var(--danger); font-weight: 700; }
  .inspector .hint.bad::before { content: '▪ '; }

  .inspector .notice {
    --px-bg: var(--cream-2);
    --px-bd: var(--wood-2);
    padding: 1rem 1.15rem; margin: 0;
    font-size: 0.92rem; color: var(--ink-soft);
  }
  .inspector .notice strong { color: var(--ink); }
  .inspector .notice.bad {
    --px-bg: var(--cream);
    --px-bd: var(--danger);
    color: var(--danger); font-weight: 700;
  }

  /* ── 검색 결과 ─────────────────────────────────────
     한 줄이 하나의 카드. 레퍼런스의 미션 판처럼 순위가 왼쪽에 붙는다. */
  .inspector .results { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .inspector .results li {
    --px-bg: var(--cream-2);
    --px-bd: var(--wood-2);
    display: grid; grid-template-columns: 2.7rem 1fr; gap: 0.75rem;
    padding: 0.95rem 1.15rem;
  }
  /* 순위 = 아이템 슬롯 번호 */
  .inspector .rank {
    font-family: var(--font-pixel);
    font-size: 15px; line-height: 22px; letter-spacing: 0; font-weight: 400;
    color: var(--on-fill); background: var(--sun);
    text-align: center;
    align-self: start;
    padding: 2px 0;
    box-shadow: 0 0 0 3px var(--wood-2);
  }
  .inspector .body { min-width: 0; }
  .inspector .head {
    display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .inspector .head a { font-weight: 700; font-size: 0.95rem; }
  .inspector .heading {
    font-family: var(--font-pixel);
    font-size: 15px; line-height: 22px; letter-spacing: 0;
    color: var(--on-fill);
    padding: 2px 8px;
    background: var(--mint);
    box-shadow: 0 0 0 2px var(--wood-2);
  }
  .inspector .version { font-size: 0.88rem; color: var(--ink-soft); }

  .inspector .score {
    display: flex; align-items: center; gap: 0.6rem;
    margin-bottom: 0.55rem;
  }
  /* 체력 게이지처럼 칸이 뚝뚝 끊기게. 부드러운 그라데이션을 쓰지 않는다. */
  .inspector .bar {
    flex: 1 1 auto; height: 12px; min-width: 4rem;
    background: var(--cream-3);
    box-shadow: 0 0 0 3px var(--wood-2);
    overflow: hidden;
  }
  .inspector .bar span {
    display: block; height: 100%;
    background: var(--rose);
    /* 4px 마다 한 칸씩 끊어 도트 게이지로 보이게 한다 */
    background-image: repeating-linear-gradient(
      90deg,
      var(--rose) 0 var(--u),
      var(--rose-2) var(--u) calc(var(--u) * 2)
    );
  }
  .inspector .num {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82rem; font-variant-numeric: tabular-nums; font-weight: 700;
  }
  .inspector .drop {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.82rem; color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  /* 낙차가 큰 지점 — 임계값을 여기쯤 두라는 신호다. */
  .inspector .drop.big { color: var(--danger); font-weight: 700; }

  .inspector .preview {
    margin: 0; font-size: 0.88rem; line-height: 1.7; color: var(--ink-soft);
  }
</style>
